# Generated by chezmoi for {{ .trustDomain }}/{{ .machineRole }} on {{ .chezmoi.os }}/{{ .chezmoi.arch }}.
# This is the complete machine-global dependency union. Project dependencies stay in projects.
{{- if .brewEnabled }}

tap "homebrew/bundle"
tap "homebrew/services"

{{- range .packages.baseFormulae }}
brew {{ . | quote }}
{{- end }}

{{- if .development }}
{{- range .packages.developmentFormulae }}
{{- if eq . "docker" }}
brew "docker", link: false
{{- else }}
brew {{ . | quote }}
{{- end }}
{{- end }}
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
{{- range .packages.darwinFormulae }}
{{- if eq . "serialosc" }}
brew "serialosc", restart_service: :changed
{{- else }}
brew {{ . | quote }}
{{- end }}
{{- end }}
{{- end }}

{{- if and (eq .chezmoi.os "darwin") .gui .manageGuiApps }}
{{- range .packages.darwinCasks }}
cask {{ . | quote }}
{{- end }}

# Explicit application exceptions. These are inventoried but are not falsely
# represented as Homebrew-owned packages.
{{- range .packages.darwinExternalApps }}
# external-app: {{ .name }}; owner={{ .owner }}; reason={{ .reason }}
{{- end }}
{{- end }}

{{- if and (eq .chezmoi.os "darwin") .development .gui }}
{{- range .packages.vscodeExtensions }}
vscode {{ . | quote }}
{{- end }}
{{- end }}

{{- if .development }}
{{- range .packages.goTools }}
go {{ . | quote }}
{{- end }}
{{- range .packages.npmTools }}
npm {{ . | quote }}
{{- end }}
{{- end }}

{{- if and (eq .chezmoi.os "darwin") .mas }}
{{- range .packages.masApps }}
mas {{ .name | quote }}, id: {{ .id }}
{{- end }}
{{- end }}

{{- if .workConfig }}
# This encrypted fragment is part of the same evaluated Brew bundle. Aborting
# when it is absent prevents a cleanup preview from treating work tools as stray.
work_brewfile = File.expand_path("~/.config/homebrew/Brewfile.work")
raise "missing encrypted work Brewfile: #{work_brewfile}" unless File.file?(work_brewfile)
eval(File.read(work_brewfile), binding, work_brewfile)
{{- end }}
{{- else }}
# Homebrew management is disabled for this machine profile.
{{- end }}
