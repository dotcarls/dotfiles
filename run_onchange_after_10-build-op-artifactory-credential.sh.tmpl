#!/bin/sh
set -eu

# Rebuild whenever the managed Go source changes.
# source-sha256: {{ include "dot_local/share/op-artifactory-credential/main.go" | sha256sum }}
source_dir="$HOME/.local/share/op-artifactory-credential"
bin_dir="$HOME/.local/bin"

mkdir -p "$bin_dir"
tmp="$(mktemp "$bin_dir/.op-artifactory-credential.XXXXXX")"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

go build -trimpath -ldflags='-s -w' -o "$tmp" "$source_dir/main.go"
chmod 0755 "$tmp"
mv -f "$tmp" "$bin_dir/op-artifactory-credential"
ln -sfn op-artifactory-credential "$bin_dir/docker-credential-op-artifactory"
ln -sfn op-artifactory-credential "$bin_dir/git-credential-op-artifactory"

trap - EXIT HUP INT TERM
