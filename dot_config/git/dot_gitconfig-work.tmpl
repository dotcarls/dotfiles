[user]
    name = {{ .workGitName | quote }}
    email = {{ .workGitEmail | quote }}
    signingKey = {{ .workSigningKey | quote }}
{{- if .secretAccess }}
[core]
    sshCommand = ssh -F ~/.config/git/ssh_config-work
[gpg]
    format = ssh
[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
{{- end }}
    allowedSignersFile = ~/.config/git/allowed_signers-work
[commit]
    gpgSign = true
{{- else }}
[commit]
    gpgSign = false
{{- end }}
