# Directory defaults cover repositories before their first remote is added.
[includeIf "gitdir:~/Work/"]
    path = ~/.config/git/.gitconfig-work

# EMU repositories override the broader Work directory identity.
[includeIf "gitdir:~/Work/src/github.com/cisco-sto/"]
    path = ~/.config/git/.gitconfig-work-emu
[includeIf "gitdir:~/Work/src/github.com/projv-engprod/"]
    path = ~/.config/git/.gitconfig-work-emu

# Remote-based rules keep identity selection correct outside the usual checkout tree.
[includeIf "hasconfig:remote.*.url:git@github.com:cisco-hypershield/**"]
    path = ~/.config/git/.gitconfig-work
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/cisco-hypershield/**"]
    path = ~/.config/git/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://github.com/cisco-hypershield/**"]
    path = ~/.config/git/.gitconfig-work

[includeIf "hasconfig:remote.*.url:git@github.com:isovalent/**"]
