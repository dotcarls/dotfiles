[includeIf "hasconfig:remote.*.url:https://github.com/isovalent/**"]
    path = ~/.config/git/.gitconfig-work

[includeIf "hasconfig:remote.*.url:git@github.com:cisco-eti/**"]
    path = ~/.config/git/.gitconfig-work
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/cisco-eti/**"]
    path = ~/.config/git/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://github.com/cisco-eti/**"]
