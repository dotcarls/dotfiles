    path = ~/.config/git/.gitconfig-work
[includeIf "hasconfig:remote.*.url:ssh://git@wwwin-github.cisco.com/**"]
    path = ~/.config/git/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://wwwin-github.cisco.com/**"]
