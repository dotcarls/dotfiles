#!/usr/bin/env zsh

typeset -U path PATH

path=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/.local/share/n/bin"
  "$HOME/.pyenv/bin"
  "$HOME/.pyenv/shims"
  "$HOME/Scratch/bin"
  "$HOME/src/github.com/containers/gvisor-tap-vsock/bin"
  "/opt/homebrew/opt/python/libexec/bin"
  $path
)

if command -v brew >/dev/null 2>&1; then
  coreutils_prefix="$(brew --prefix coreutils 2>/dev/null)"
  [[ -d "$coreutils_prefix/libexec/gnubin" ]] && path=("$coreutils_prefix/libexec/gnubin" $path)
  unset coreutils_prefix
fi

export N_PREFIX="$HOME/.local/share/n"
export PYENV_ROOT="$HOME/.pyenv"

if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
fi
