#!/usr/bin/env zsh

alias cm=chezmoi
alias cma='chezmoi apply'
alias cmd='chezmoi diff'
alias cme='chezmoi edit'
alias cmezrc='chezmoi edit ~/.zshrc'
# Remote-to-local update. Use `cms` for the opposite direction.
alias cmu='chezmoi update'
# One-shot local source save: initialize, apply, stage, commit, rebase, verify,
# and push without force. Direct `dotfiles-save` runs now require confirmation or
# explicit `--yes`; `save-dotfiles` preserves the historical review flow.
alias cms='dotfiles-save'

fcme() {
  local managed_file
  managed_file="$(chezmoi managed | fzf --no-multi -q "${1:-}")" || return
  [[ -n "$managed_file" ]] && chezmoi edit -- "$managed_file"
}

save-dotfiles() {
  local commit_message=${1:?a commit message must be specified}

  printf '\n\n'
  lg $0 'local diff:'
  GIT_PAGER=cat LESS="${LESS} -FRXK" chezmoi --no-pager diff || echo 'no diff'

  printf '\n\n'
  lg $0 'remote diff:'
  GIT_PAGER=cat LESS="${LESS} -FRXK" chezmoi git --no-pager diff || echo 'no diff'
  printf '\n\n'

  if read -q "choice?continue? (Y/y): "; then
    echo
    dotfiles-save --yes "$commit_message" || return
    if command -v reload-zsh >/dev/null 2>&1; then
      reload-zsh
    else
      print 'dotfiles saved. Reload the shell with `exec zsh` to pick up changes.'
    fi
  else
    echo
    echo "'$choice' not 'Y' or 'y'. Skipping..."
  fi
}

dotfiles-review() {
  chezmoi --no-pager diff
  chezmoi git -- status --short
}

# Commit only content the operator has already staged after review. Applying
# and pushing are separate, explicit operations.
dotfiles-commit() {
  local commit_message=${1:?a commit message must be specified}
  if chezmoi git -- diff --cached --quiet; then
    print -u2 'No staged dotfiles changes to commit.'
    return 1
  fi
  chezmoi git -- diff --cached
  chezmoi git -- commit -m "$commit_message"
}
