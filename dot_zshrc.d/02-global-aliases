#!/usr/bin/env zsh

command -v python3 >/dev/null 2>&1 && alias python=python3

alias deps-check='dotfiles-brew check'
alias deps-apply='dotfiles-brew apply'
alias deps-upgrade='dotfiles-brew upgrade'
alias update-global-deps-brew='dotfiles-brew upgrade'
alias deps-inventory='dotfiles-brew inventory'
alias deps-cleanup-preview='dotfiles-brew cleanup-preview'

update-global-deps-npm() {
  npm update -g "$@"
}

update-global-deps() {
  update-global-deps-npm "$@" && update-global-deps-brew
}

auto-commit-stats() {
  local stats_runner="$HOME/.local/src/github/dotcarls/auto-commit-stats/run.sh"
  if [[ ! -x "$stats_runner" ]]; then
    print -u2 "auto-commit-stats is not installed: $stats_runner"
    return 1
  fi
  "$stats_runner" "$@"
}

auto-commit-stats-bg() {
  (auto-commit-stats "$@" >/dev/null 2>&1 &)
}

alias glances='glances --theme-white'

if [[ -x "/Applications/Screaming Frog SEO Spider.app/Contents/MacOS/ScreamingFrogSEOSpiderLauncher" ]]; then
  alias sfseospider='"/Applications/Screaming Frog SEO Spider.app/Contents/MacOS/ScreamingFrogSEOSpiderLauncher"'
fi
