#!/usr/bin/env python3
# Keep the resulting npm configuration private even though it stores only refs.
import sys

BEGIN = "# BEGIN chezmoi-managed Cisco Artifactory"
END = "# END chezmoi-managed Cisco Artifactory"
HOSTS = (
    "artifactory.devhub-cloud.cisco.com",
    "devhub-docker.cisco.com",
    "devhub.cisco.com",
    "dockerhub.cisco.com",
    "engci-maven-master.cisco.com",
    "engci-maven.cisco.com",
    "gitlfs.cisco.com",
)
SCOPES = ("@daf:", "@projv:", "@ciscodesignsystems:")

kept = []
inside = False
for line in sys.stdin.read().splitlines():
    if line == BEGIN:
        inside = True
        continue
    if line == END:
        inside = False
        continue
    if inside or any(host in line for host in HOSTS) or line.startswith(SCOPES):
        continue
    kept.append(line)

while kept and kept[-1] == "":
    kept.pop()

managed = [
    BEGIN,
    "@projv:registry=https://engci-maven.cisco.com/artifactory/api/npm/projv-engprod-npm/",
    "@daf:registry=https://engci-maven-master.cisco.com/artifactory/api/npm/daf-npm-local/",
    "@ciscodesignsystems:registry=https://artifactory.devhub-cloud.cisco.com/artifactory/api/npm/magnetic-common-npm/",
    "//engci-maven.cisco.com/:_auth=${ARTIFACTORY_RTP_AUTH}",
    "//engci-maven.cisco.com/artifactory/api/npm/projv-engprod-npm/:_auth=${ARTIFACTORY_RTP_AUTH}",
    "//engci-maven.cisco.com/artifactory/api/npm/eti-sre-npm/:_auth=${ARTIFACTORY_RTP_AUTH}",
    "//engci-maven-master.cisco.com/:_auth=${ARTIFACTORY_MASTER_AUTH}",
    "//engci-maven-master.cisco.com/artifactory/api/npm/daf-npm-local/:_auth=${ARTIFACTORY_MASTER_AUTH}",
    "//artifactory.devhub-cloud.cisco.com/:_auth=${ARTIFACTORY_DEVHUB_CLOUD_AUTH}",
    "//artifactory.devhub-cloud.cisco.com/artifactory/api/npm/magnetic-common-npm/:_auth=${ARTIFACTORY_DEVHUB_CLOUD_AUTH}",
    "//artifactory.devhub-cloud.cisco.com/artifactory/api/npm/isovalent-eng-npm/:_auth=${ARTIFACTORY_DEVHUB_CLOUD_AUTH}",
    "//artifactory.devhub-cloud.cisco.com/artifactory/api/npm/platform-sdk/:_auth=${ARTIFACTORY_DEVHUB_CLOUD_AUTH}",
    "//devhub.cisco.com/:_auth=${ARTIFACTORY_DEVHUB_LEGACY_AUTH}",
    "//devhub-docker.cisco.com/:_auth=${ARTIFACTORY_DEVHUB_LEGACY_AUTH}",
    END,
]

if kept:
    kept.append("")
kept.extend(managed)
sys.stdout.write("\n".join(kept) + "\n")
