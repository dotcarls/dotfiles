#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
Usage: dotfiles-brew COMMAND

Commands:
  check            Check that the rendered global Brewfile is satisfied.
  apply            Install missing entries without a general upgrade pass.
  upgrade          Explicitly update Homebrew and upgrade declared entries.
  inventory        Print Bundle plus raw macOS application inventories.
  inventory-bundle Print a valid Bundle snapshot to stdout; change nothing.
  inventory-apps   Print raw macOS app and App Store receipt inventories.
  cleanup-preview  Show undeclared entries; never remove anything.
  doctor           Run Homebrew diagnostics.
EOF
}

find_brew() {
    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    printf '%s\n' 'Homebrew is not installed in a supported prefix.' >&2
    exit 127
}

brew_bin=$(find_brew)

run_brew() (
    unset HOMEBREW_GITHUB_API_TOKEN

    if [ "$(/usr/bin/uname -s)" = Darwin ] &&
        /usr/bin/security find-generic-password \
            -a github.com-public-rest \
            -s dotfiles-homebrew-github-api >/dev/null 2>&1; then
        if ! dotfiles_brew_github_api_token=$(
            /usr/bin/security find-generic-password \
                -a github.com-public-rest \
                -s dotfiles-homebrew-github-api \
                -w
        ); then
            printf '%s\n' \
                'Unable to read the Homebrew GitHub API token from macOS Keychain.' >&2
            exit 1
        fi
        if [ -z "$dotfiles_brew_github_api_token" ]; then
            printf '%s\n' \
                'The Homebrew GitHub API token in macOS Keychain is empty.' >&2
            exit 1
        fi

        HOMEBREW_GITHUB_API_TOKEN=$dotfiles_brew_github_api_token
        export HOMEBREW_GITHUB_API_TOKEN
        unset dotfiles_brew_github_api_token
    fi

    exec "$brew_bin" "$@"
)

bundle_inventory() {
    run_brew bundle dump --file=- --no-describe
}

application_inventory() {
    if [ "$(uname -s)" != Darwin ]; then
        printf '%s\n' '# Application inventory is only applicable to macOS.'
        return
    fi

    printf '\n%s\n' '# Application bundles (includes installations outside Homebrew receipts)'
    /usr/bin/find /Applications -maxdepth 1 -name '*.app' -prune -print
    if [ -d "$HOME/Applications" ]; then
        /usr/bin/find "$HOME/Applications" -maxdepth 1 -name '*.app' -prune -print
    fi

    printf '\n%s\n' '# Application bundles carrying Mac App Store receipts'
    /usr/bin/find /Applications -path '*/Contents/_MASReceipt/receipt' -print
    if [ -d "$HOME/Applications" ]; then
        /usr/bin/find "$HOME/Applications" -path '*/Contents/_MASReceipt/receipt' -print
    fi
}

command_name=${1:-}
case "$command_name" in
    check)
        run_brew bundle check --global --verbose
        ;;
    apply)
        run_brew bundle install --global --no-upgrade
        ;;
    upgrade)
        run_brew update
        run_brew bundle upgrade --global
        ;;
    inventory)
        bundle_inventory
        application_inventory
        ;;
    inventory-bundle)
        run_brew bundle dump --file=- --no-describe
        ;;
    inventory-apps)
        application_inventory
        ;;
    cleanup-preview)
        run_brew bundle cleanup --global --all
        ;;
    doctor)
        run_brew doctor
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
