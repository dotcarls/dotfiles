#!/bin/sh
set -eu

tool="$(basename "$0")"
real_tool=

# Prefer the executable selected by mise for the current project.  The wrapper
# itself stays first on PATH, while `mise which` returns the underlying binary
# without recursing through this symlink.
if [ -x "$HOME/.local/bin/mise" ]; then
    real_tool="$("$HOME/.local/bin/mise" which "$tool" 2>/dev/null || true)"
fi

# Not every package manager is necessarily managed by mise.  Keep the existing
# n installation as the compatibility fallback for pnpm/Yarn/Corepack shims.
if [ -z "$real_tool" ] || [ ! -x "$real_tool" ]; then
    real_tool="$HOME/.local/share/n/bin/$tool"
fi

if [ ! -x "$real_tool" ]; then
    printf 'No underlying %s executable found at %s\n' "$tool" "$real_tool" >&2
    exit 127
fi

# Introspection is local-only and must never trigger a vault request.
case "${1:-}" in
    -v|--version|-h|--help|help|version)
        exec "$real_tool" "$@"
        ;;
esac

# npm lifecycle and local-inspection commands operate on the installed project
# and do not contact a package registry themselves.  If a lifecycle script
# launches a registry operation (for example, a nested `npm ci`), that child
# resolves this wrapper again and obtains credentials at that point.
if [ "$tool" = npm ]; then
    case "${1:-}" in
        run|run-script|test|start|stop|restart|ls|list|ll|la|explain|query|prefix|root|config)
            exec "$real_tool" "$@"
            ;;
    esac
fi

# npm-family clients do not implement an external credential-helper protocol.
# Detect the registries needed by this invocation and resolve only those JFrog
# credentials, for this process lifetime, in one 1Password transaction.
need_rtp=0
need_master=0
need_cloud=0
need_legacy=0

classify() {
    case "$1" in
        *engci-maven.cisco.com*|*@projv/*) need_rtp=1 ;;
    esac
    case "$1" in
        *engci-maven-master.cisco.com*|*@daf/*) need_master=1 ;;
    esac
    case "$1" in
        *artifactory.devhub-cloud.cisco.com*|*@ciscodesignsystems/*|*@isovalent/*) need_cloud=1 ;;
    esac
    case "$1" in
        *devhub.cisco.com*|*devhub-docker.cisco.com*) need_legacy=1 ;;
    esac
}

for argument in "$@"; do
    classify "$argument"
done
classify "${NPM_CONFIG_REGISTRY:-} ${npm_config_registry:-} ${NPM_REGISTRY:-} ${ARTIFACTORY_URL:-}"

scan_dir=$PWD
while [ "$scan_dir" != / ]; do
    # ~/.npmrc contains every supported registry by design; it is routing
    # metadata, not evidence that a particular invocation needs every token.
    [ "$scan_dir" = "$HOME" ] && break
    for project_file in .npmrc package.json package-lock.json npm-shrinkwrap.json pnpm-lock.yaml yarn.lock; do
        candidate="$scan_dir/$project_file"
        [ -f "$candidate" ] || continue
        grep -Eq 'engci-maven\.cisco\.com|@projv/' "$candidate" && need_rtp=1 || true
        grep -Eq 'engci-maven-master\.cisco\.com|@daf/' "$candidate" && need_master=1 || true
        grep -Eq 'artifactory\.devhub-cloud\.cisco\.com|@ciscodesignsystems/|@isovalent/' "$candidate" && need_cloud=1 || true
        grep -Eq 'devhub\.cisco\.com|devhub-docker\.cisco\.com' "$candidate" && need_legacy=1 || true
    done
    [ -d "$scan_dir/.git" ] && break
    scan_dir="$(dirname "$scan_dir")"
done

if [ "$need_rtp" -eq 0 ] && [ "$need_master" -eq 0 ] && \
   [ "$need_cloud" -eq 0 ] && [ "$need_legacy" -eq 0 ]; then
    exec "$real_tool" "$@"
fi

template_file="$HOME/.config/1Password/artifactory.env.tpl"
artifactory_template=
if [ "$need_rtp" -eq 1 ]; then
    artifactory_template="${artifactory_template}$(grep '^export ARTIFACTORY_RTP_TOKEN=' "$template_file")
"
fi
if [ "$need_master" -eq 1 ]; then
    artifactory_template="${artifactory_template}$(grep '^export ARTIFACTORY_MASTER_TOKEN=' "$template_file")
"
fi
if [ "$need_cloud" -eq 1 ]; then
    artifactory_template="${artifactory_template}$(grep '^export ARTIFACTORY_DEVHUB_CLOUD_TOKEN=' "$template_file")
"
fi
if [ "$need_legacy" -eq 1 ]; then
    artifactory_template="${artifactory_template}$(grep '^export ARTIFACTORY_DEVHUB_LEGACY_TOKEN=' "$template_file")
"
fi

artifactory_exports="$(printf '%s' "$artifactory_template" | op inject)"
eval "$artifactory_exports"
unset artifactory_exports artifactory_template

if [ "$need_rtp" -eq 1 ]; then
    ARTIFACTORY_RTP_AUTH="$(printf 'ticarlso:%s' "$ARTIFACTORY_RTP_TOKEN" | base64 | tr -d '\n')"
    export ARTIFACTORY_RTP_AUTH ARTIFACTORY_RTP_USERNAME=ticarlso
    export ARTIFACTORY_USER=ticarlso ARTIFACTORY_USERNAME=ticarlso
    export ARTIFACTORY_PASSWORD="$ARTIFACTORY_RTP_TOKEN"
    export ARTIFACTORY_PASS="$ARTIFACTORY_RTP_TOKEN"
    export ARTIFACTORY_TOKEN="$ARTIFACTORY_RTP_TOKEN"
    export ARTIFACTORY_AUTH="$ARTIFACTORY_RTP_AUTH"
    export NPM_REGISTRY_USER=ticarlso NPM_REGISTRY_TOKEN="$ARTIFACTORY_RTP_TOKEN"
fi
if [ "$need_master" -eq 1 ]; then
    ARTIFACTORY_MASTER_AUTH="$(printf 'ticarlso:%s' "$ARTIFACTORY_MASTER_TOKEN" | base64 | tr -d '\n')"
    export ARTIFACTORY_MASTER_AUTH ARTIFACTORY_MASTER_USERNAME=ticarlso
fi
if [ "$need_cloud" -eq 1 ]; then
    ARTIFACTORY_DEVHUB_CLOUD_AUTH="$(printf 'ticarlso:%s' "$ARTIFACTORY_DEVHUB_CLOUD_TOKEN" | base64 | tr -d '\n')"
    export ARTIFACTORY_DEVHUB_CLOUD_AUTH ARTIFACTORY_DEVHUB_CLOUD_USERNAME=ticarlso
    export ARTIFACTORY_CLOUD_USER=ticarlso ARTIFACTORY_CLOUD_AUTH="$ARTIFACTORY_DEVHUB_CLOUD_AUTH"
    export MAGNETIC_NPM_TOKEN="$ARTIFACTORY_DEVHUB_CLOUD_TOKEN"
fi
if [ "$need_legacy" -eq 1 ]; then
    ARTIFACTORY_DEVHUB_LEGACY_AUTH="$(printf 'ticarlso:%s' "$ARTIFACTORY_DEVHUB_LEGACY_TOKEN" | base64 | tr -d '\n')"
    export ARTIFACTORY_DEVHUB_LEGACY_AUTH ARTIFACTORY_DEVHUB_LEGACY_USERNAME=ticarlso
fi
export CEC_USER=ticarlso
export CEC_EMAIL=ticarlso@cisco.com

exec "$real_tool" "$@"
